# Service HTTP Port
PORT=8083

# Dedicated Database (PostgreSQL 17 - Notification Service)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=shareride_notification
DB_USER=shareride_notification_usr
DB_PASSWORD=notification_secret_password

# Asynchronous Message Broker (RabbitMQ)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=shareride_mq
RABBITMQ_PASSWORD=mq_secret_password

# Cache Connection (Shared Valkey)
CACHE_SHARED_HOST=localhost
CACHE_SHARED_PORT=6379
CACHE_SHARED_PASSWORD=shared_valkey_secret

# Resend Email Provider
RESEND_API_KEY=re_test_placeholder
RESEND_FROM_EMAIL=ShareRide <onboarding@resend.dev>

# gRPC Inter-Service Communication Channels
GRPC_AUTH_SERVICE_HOST=localhost
GRPC_AUTH_SERVICE_PORT=9091
GRPC_RIDE_SERVICE_HOST=localhost
GRPC_RIDE_SERVICE_PORT=9092
