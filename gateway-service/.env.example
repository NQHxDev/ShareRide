# ==============================================================================
# ShareRide Gateway Service - Environment Template
# Copy this file to .env in gateway-service:
#   cp gateway-service/.env.example gateway-service/.env
# ==============================================================================

# Service HTTP Port
PORT=8080

# Cache Connection (Valkey Rate Limiter Bucket)
CACHE_SHARED_HOST=localhost
CACHE_SHARED_PORT=6379
CACHE_SHARED_PASSWORD=shared_valkey_secret

# Downstream Microservices Routing
AUTH_SERVICE_URI=http://localhost:8081

# JWT Cryptographic Configuration (EdDSA / Ed25519 - RFC 8037)
# API Gateway ONLY requires the Public Key (x parameter) for perimeter verification
JWT_PUBLIC_KEY_JWK={"kty":"OKP","crv":"Ed25519","kid":"shareride-auth-key-1","use":"sig","x":"<BASE64URL_32_BYTES_PUBLIC_KEY>"}
