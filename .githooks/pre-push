#!/bin/bash

# ShareRide Pre-Push Hook
# Comprehensive build and test verification before pushing to remote

set -e

# Terminal colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_error() {
   echo -e "${RED}[ERROR] $1${NC}"
}

print_success() {
   echo -e "${GREEN}[SUCCESS] $1${NC}"
}

print_info() {
   echo -e "${BLUE}[INFO] $1${NC}"
}

print_warn() {
   echo -e "${YELLOW}[WARN] $1${NC}"
}

echo -e "${BLUE}[Pre-push] Verifying branches & changes...${NC}"

# Read push refs from standard input: <local_ref> <local_sha> <remote_ref> <remote_sha>
all_deletions=true
has_refs=false

while read local_ref local_sha remote_ref remote_sha; do
   has_refs=true

   # Zero SHA indicates ref deletion
   if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
      print_info "Deleting remote ref: $remote_ref"
      continue
   fi

   all_deletions=false
   BRANCH_NAME=$(echo "$remote_ref" | sed 's@^refs/heads/@@')
   print_info "Pushing to remote branch: [$BRANCH_NAME]"

   # Protected branch check (prevent direct push to main or master)
   if [ "$BRANCH_NAME" = "main" ] || [ "$BRANCH_NAME" = "master" ]; then
      if [ "${ALLOW_DIRECT_PUSH}" != "1" ]; then
         echo ""
         print_error "Direct push to protected branch '$BRANCH_NAME' is forbidden!"
         print_info "Please create a feature branch and submit a Pull Request instead..."
         print_info "If this is emergency, bypass with: ALLOW_DIRECT_PUSH=1 git push ..."
         echo ""
         exit 1
      else
         print_warn "ALLOW_DIRECT_PUSH=1 detected. Proceeding with push to '$BRANCH_NAME'..."
      fi
   fi
done

# If user is only deleting remote branch(es), skip build & test checks
if [ "$has_refs" = true ] && [ "$all_deletions" = true ]; then
   print_info "Only remote branch deletions detected. Skipping build and test suite..."
   exit 0
fi

echo ""
echo -e "${YELLOW}[Pre-push] Running full verification suite...${NC}"
print_info "Tasks: clean build -> test suite -> spotless formatting -> checkstyle"
print_info "Executing unified Maven pipeline..."
echo ""

START_TIME=$(date +%s)

# Single Maven command avoids repeatedly bootstrapping the JVM (saving ~15-20s)
if mvn clean test spotless:check checkstyle:check; then
   END_TIME=$(date +%s)
   DURATION=$((END_TIME - START_TIME))
   echo ""
   print_success "✓ All pre-push verifications passed in ${DURATION}s!"
   print_info "Proceeding with push to remote repository..."
   echo ""
   exit 0
else
   echo ""
   print_error "Pre-push verification failed!"
   print_info "✗ All tests, formatting rules, and style checks must pass before pushing..."
   echo ""
   exit 1
fi
