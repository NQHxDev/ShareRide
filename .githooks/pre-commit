#!/bin/bash

# ShareRide Pre-Commit Hook
# Fast quality verification before code is committed

set -e

# Terminal colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_error() {
   echo -e "${RED}[ERROR] $1${NC}"
}

print_success() {
   echo -e "${GREEN}[SUCCESS] $1${NC}"
}

print_info() {
   echo -e "${YELLOW}[INFO] $1${NC}"
}

echo -e "${BLUE}[Pre-commit] Starting verification...${NC}"

# Check for staged Java files and build configurations
STAGED_JAVA_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.java$' || true)
STAGED_POM_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep 'pom\.xml$' || true)

if [ -z "$STAGED_JAVA_FILES" ] && [ -z "$STAGED_POM_FILES" ]; then
   print_info "No Java source or POM files staged for commit. Skipping Java checks."
   exit 0
fi

if [ -n "$STAGED_JAVA_FILES" ]; then
   print_info "Staged Java files detected:"
   echo "$STAGED_JAVA_FILES" | sed 's/^/  - /'
fi

if [ -n "$STAGED_POM_FILES" ]; then
   print_info "Staged POM files detected:"
   echo "$STAGED_POM_FILES" | sed 's/^/  - /'
fi

# 1. Check code formatting with Spotless
echo ""
echo -e "${BLUE}[1/4] Checking code formatting (Spotless)...${NC}"
if mvn spotless:check; then
   print_success "✓ Code formatting check passed..."
else
   print_error "✗ Code formatting check failed!"
   print_info "Run 'mvn spotless:apply' to automatically reformat your code..."
   exit 1
fi

# 2. Check code style with Checkstyle
echo ""
echo -e "${BLUE}[2/4] Checking code style (Checkstyle)...${NC}"
if mvn checkstyle:check; then
   print_success "✓ Code style check passed..."
else
   print_error "✗ Code style violations detected!"
   print_info "Please resolve the Checkstyle violations listed above..."
   exit 1
fi

# 3. Fast incremental compilation (main + test classes)
echo ""
echo -e "${BLUE}[3/4] Compiling project (Incremental test-compile)...${NC}"
if mvn test-compile -DskipTests; then
   print_success "✓ Compilation successful..."
else
   print_error "✗ Compilation failed!"
   exit 1
fi

# 4. Run unit tests for affected modules
echo ""
echo -e "${BLUE}[4/4] Running unit tests for affected modules...${NC}"

if [ "${SKIP_TESTS}" = "1" ] || [ "${FAST}" = "1" ]; then
   print_info "SKIP_TESTS=1 detected. Skipping unit tests on commit..."
else
   # Identify affected modules from staged files
   ALL_STAGED="$STAGED_JAVA_FILES"$'\n'"$STAGED_POM_FILES"
   AFFECTED_MODULES=$(echo "$ALL_STAGED" | grep -o '^[^/]*' | sort -u | grep -v '^pom.xml$' | grep -v '^$' || true)

   if [ -z "$AFFECTED_MODULES" ]; then
      # If changes are only at root or all modules, run standard test suite
      print_info "Root configuration changed. Testing all modules..."
      if mvn test; then
         print_success "✓ All module tests passed..."
      else
         print_error "✗ Tests failed!"
         exit 1
      fi
   else
      MODULE_LIST=$(echo "$AFFECTED_MODULES" | tr '\n' ',' | sed 's/,$//')
      print_info "Testing affected module(s): ${MODULE_LIST}"

      for module in $AFFECTED_MODULES; do
         if [ -d "$module" ] && [ -f "$module/pom.xml" ]; then
            echo "  --> Testing module: $module"
            if mvn test -pl "$module" -am; then
               print_success "✓ Tests passed for module [$module]..."
            else
               print_error "✗ Tests failed for module [$module]!"
               exit 1
            fi
         fi
      done
   fi
fi

echo ""
print_success "✓ All pre-commit checks passed successfully!"
echo ""

exit 0
