#!/bin/bash

# ==============================================================================
# ShareRide Pre-Commit Hook
# Fast quality verification before code is committed:
#   1. Format check & auto-fix (Spotless / Google Java Format)
#   2. Code style, standards & lint checks (Checkstyle)
# Note: Tests are intentionally NOT run during commit to keep it fast (< 2-3s).
#       Full build and comprehensive test suite run on 'git push'.
# ==============================================================================

set -e

# Terminal colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

print_error() {
   echo -e "${RED}[ERROR] $1${NC}"
}

print_success() {
   echo -e "${GREEN}[SUCCESS] $1${NC}"
}

print_info() {
   echo -e "${BLUE}[INFO] $1${NC}"
}

print_warn() {
   echo -e "${YELLOW}[WARN] $1${NC}"
}

# Allow bypassing via environment variable if needed in rare cases
if [ "${SKIP_HOOKS}" = "1" ] || [ "${SKIP_PRE_COMMIT}" = "1" ]; then
   print_warn "SKIP_HOOKS detected. Skipping pre-commit checks."
   exit 0
fi

echo -e "${CYAN}${BOLD}[Pre-commit] Starting fast code format & lint verification...${NC}"

# Detect Maven command (prefer system 'mvn', fallback to './mvnw')
if command -v mvn >/dev/null 2>&1; then
   MVN_CMD="mvn"
elif [ -x "./mvnw" ]; then
   MVN_CMD="./mvnw"
else
   print_error "Neither 'mvn' nor './mvnw' was found in PATH."
   exit 1
fi

# Detect staged files that require formatting or linting
STAGED_JAVA_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.java$' || true)
STAGED_CONFIG_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(pom\.xml|checkstyle\.xml)' || true)

if [ -z "$STAGED_JAVA_FILES" ] && [ -z "$STAGED_CONFIG_FILES" ]; then
   print_info "No Java source or build configurations staged. Skipping Java checks."
   exit 0
fi

if [ -n "$STAGED_JAVA_FILES" ]; then
   STAGED_COUNT=$(echo "$STAGED_JAVA_FILES" | grep -c . || true)
   print_info "Staged Java files ($STAGED_COUNT file(s)) detected for validation."
fi

# ------------------------------------------------------------------------------
# 1. Code Formatting (Spotless - Google Java Format AOSP)
# ------------------------------------------------------------------------------
echo ""
echo -e "${BLUE}[1/2] Checking code formatting (Spotless)...${NC}"
if ! $MVN_CMD spotless:check -q > /dev/null 2>&1; then
   print_warn "Format violations detected. Automatically applying Spotless formatting..."
   $MVN_CMD spotless:apply -q

   # Re-stage only originally staged Java files
   echo "$STAGED_JAVA_FILES" | while IFS= read -r file; do
      if [ -n "$file" ] && [ -f "$file" ]; then
         git add "$file"
      fi
   done
   print_success "✓ Code formatted according to standard and re-staged automatically!"
else
   print_success "✓ Code formatting check passed (Spotless)..."
fi

# ------------------------------------------------------------------------------
# 2. Code Standards & Linting (Checkstyle)
# ------------------------------------------------------------------------------
echo ""
echo -e "${BLUE}[2/2] Checking code style & standards (Checkstyle)...${NC}"
if $MVN_CMD checkstyle:check --batch-mode; then
   print_success "✓ Code style and standards check passed (Checkstyle)..."
else
   echo ""
   print_error "✗ Code style/lint violations detected!"
   echo -e "${YELLOW}Vui lòng sửa các lỗi Checkstyle được liệt kê ở trên trước khi commit.${NC}"
   echo -e "${YELLOW}Gợi ý:${NC}"
   echo -e "  - Kiểm tra import không dùng (* import, unused import)"
   echo -e "  - Kiểm tra quy tắc đặt tên (camelCase, CONSTANT_CASE), độ dài dòng (<= 120 ký tự)"
   echo -e "  - Chạy '${BOLD}mvn checkstyle:check${NC}' để xem lại danh sách vi phạm"
   echo ""
   exit 1
fi

# ------------------------------------------------------------------------------
# Completion summary
# ------------------------------------------------------------------------------
echo ""
print_success "✓ Tất cả kiểm tra format & lint trước khi commit đều đạt chuẩn!"
print_info "(Lưu ý: Không chạy test ở bước commit để tối ưu tốc độ. Toàn bộ test suite & build sẽ chạy khi 'git push')"
echo ""

exit 0
