# Shared Distributed Cache (Valkey 8 / Redis)
CACHE_SHARED_HOST=localhost
CACHE_SHARED_PORT=6379
CACHE_SHARED_PASSWORD=shared_valkey_secret
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=shared_valkey_secret

# Shared Asynchronous Message Broker (RabbitMQ)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=shareride_mq
RABBITMQ_PASSWORD=mq_secret_password

# Platform Service URIs
GATEWAY_PORT=8080
AUTH_SERVICE_URI=http://localhost:8081
AUTH_SERVICE_PORT=8081
