{
   "java.configuration.updateBuildConfiguration": "automatic",
   "files.exclude": {
      "**/.omni": true,
      "**/target": true,
      "**/.m2": true
   },
   "search.exclude": {
      "**/target": true,
      "**/.m2": true,
      "**/.mvn": true
   },
   "java.compile.nullAnalysis.mode": "automatic",
   "[java]": {
      "editor.tabSize": 4,
      "editor.indentSize": 4,
      "editor.insertSpaces": true,
      "editor.detectIndentation": false
   },
   "[yaml]": {
      "editor.tabSize": 2,
      "editor.indentSize": 2,
      "editor.insertSpaces": true,
      "editor.detectIndentation": false
   },
   "[yml]": {
      "editor.tabSize": 2,
      "editor.indentSize": 2,
      "editor.insertSpaces": true,
      "editor.detectIndentation": false
   }
}
