# ShareRide Common Messages - English (EN)
SUCCESS=Success
CREATED=Created successfully
ACCEPTED=Request accepted for processing
NO_CONTENT=No content
BAD_REQUEST=Bad request
UNAUTHORIZED=Unauthorized access or session has expired
PAYMENT_REQUIRED=Payment required to access this resource
FORBIDDEN=You do not have permission to access this resource
NOT_FOUND=The requested resource could not be found
METHOD_NOT_ALLOWED=HTTP method not allowed
CONFLICT=Resource conflict or already exists
UNPROCESSABLE_ENTITY=Unprocessable entity
RATE_LIMIT_EXCEEDED=Rate limit exceeded, please try again later
TOO_MANY_REQUESTS=Too many requests, please slow down
REQUEST_TIMEOUT=Request timed out
VALIDATION_FAILED=Validation failed for input data
INTERNAL_SERVER_ERROR=An internal server error occurred, please try again later
BAD_GATEWAY=Bad gateway
SERVICE_UNAVAILABLE=Service is temporarily unavailable
GATEWAY_TIMEOUT=Gateway timed out
CIRCUIT_BREAKER_OPEN=Service circuit breaker is open, please retry later

# Parameterized Templates
RESOURCE_NOT_FOUND=Could not find ${resource!'resource'} with identifier '${identifier!'unknown'}'
FIELD_REQUIRED=Field '${field}' is required
FIELD_INVALID=Field '${field}' contains an invalid value: ${value!''}
