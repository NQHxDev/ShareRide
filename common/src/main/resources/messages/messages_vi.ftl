# ShareRide Common Messages - Tiếng Việt (VN)
SUCCESS=Thành công
CREATED=Tạo mới thành công
ACCEPTED=Yêu cầu đã được tiếp nhận
NO_CONTENT=Không có nội dung trả về
BAD_REQUEST=Yêu cầu không hợp lệ
UNAUTHORIZED=Bạn chưa đăng nhập hoặc phiên làm việc đã hết hạn
PAYMENT_REQUIRED=Yêu cầu thanh toán để tiếp tục
FORBIDDEN=Bạn không có quyền truy cập tài nguyên này
NOT_FOUND=Không tìm thấy tài nguyên yêu cầu
METHOD_NOT_ALLOWED=Phương thức HTTP không được hỗ trợ
CONFLICT=Dữ liệu bị xung đột hoặc đã tồn tại
UNPROCESSABLE_ENTITY=Dữ liệu không thể xử lý
RATE_LIMIT_EXCEEDED=Đã vượt quá giới hạn tần suất yêu cầu, vui lòng thử lại sau
TOO_MANY_REQUESTS=Quá nhiều yêu cầu gửi tới hệ thống, vui lòng thử lại sau
REQUEST_TIMEOUT=Hết thời gian chờ yêu cầu
VALIDATION_FAILED=Dữ liệu đầu vào không hợp lệ
INTERNAL_SERVER_ERROR=Hệ thống đang gặp sự cố, vui lòng thử lại sau
BAD_GATEWAY=Cổng kết nối không hợp lệ
SERVICE_UNAVAILABLE=Dịch vụ hiện không khả dụng
GATEWAY_TIMEOUT=Hết thời gian chờ cổng kết nối
CIRCUIT_BREAKER_OPEN=Dịch vụ tạm thời ngắt kết nối an toàn (circuit breaker)

# Parameterized Templates
RESOURCE_NOT_FOUND=Không tìm thấy ${resource!'tài nguyên'} với mã '${identifier!'không xác định'}'
FIELD_REQUIRED=Trường '${field}' không được để trống
FIELD_INVALID=Trường '${field}' có giá trị không hợp lệ: ${value!''}
