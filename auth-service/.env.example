# Service HTTP Port
PORT=8081

# Dedicated Database (PostgreSQL 17 - Isolated per-service)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shareride_auth
DB_USER=shareride_auth_usr
DB_PASSWORD=auth_secret_password

# Cache Connection (Valkey Token Store & Refresh Token Cache)
CACHE_SHARED_HOST=localhost
CACHE_SHARED_PORT=6379
CACHE_SHARED_PASSWORD=shared_valkey_secret

# JWT Cryptographic Configuration (EdDSA / Ed25519 - RFC 8037)
# Run ./scripts/generate-jwt-keys.sh to generate fresh asymmetric keys
JWT_KEY_ID=shareride-auth-key-1
JWT_PRIVATE_KEY_JWK={"kty":"OKP","crv":"Ed25519","kid":"shareride-auth-key-1","use":"sig","d":"<BASE64URL_32_BYTES_PRIVATE_KEY>","x":"<BASE64URL_32_BYTES_PUBLIC_KEY>"}
JWT_PUBLIC_KEY_JWK={"kty":"OKP","crv":"Ed25519","kid":"shareride-auth-key-1","use":"sig","x":"<BASE64URL_32_BYTES_PUBLIC_KEY>"}
